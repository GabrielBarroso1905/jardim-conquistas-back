DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goals"

# Só para scripts/transfer-database.sh (origem → destino); não usado pelo app em runtime
# DATABASE_URL_NEW="postgresql://postgres:postgres@localhost:5432/goals_new"
# Sync main → production: .env_main (origem) + .env (destino) via npm run sync:main-to-prod -- --yes
# Storage Supabase→Supabase: npm run storage:transfer:supabase (origem: STORAGE_TRANSFER_SOURCE_ENV=.env_main)

# Coolify injeta PORT no container; localmente o default é 3000 (main.ts)
# PORT=3000

# CORS da API (vírgula-separado, sem barra final):
#   (omitir ou vazio) = reflete qualquer Origin
#   *                 = idem (qualquer origem)
#   URLs explícitas   = só essas origens (recomendado em prod)
#   Front local contra API remota: inclua http://localhost:8080 (Vite/outros) e :5173
#   API usa credentials: false — o front deve usar fetch credentials: "omit" (ver docs/CORS_FRONTEND.md)
CORS_ALLOWED_ORIGINS=https://jardim.sowtech.io,https://jardim.chebl.cloud,http://localhost:5173,http://localhost:8080

# Fuso padrão para agendamentos quando o usuário não configurou (IANA)
APP_TIMEZONE=America/Fortaleza
SUPABASE_URL=https://supabase.sowtech.io
SUPABASE_KEY="anon-key"
# Servidor: bucket Storage privado (leitura, proxy /api/assets, imports)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=jardim-das-conquistas
# Opcional: usa Supabase/URLs de outro arquivo só para assets (ex. DB production + storage main)
# STORAGE_ENV_OVERLAY=.env_main
# ASSETS_PUBLIC_BASE_URL=https://api.sowtech.io

STORAGE_PROVIDER=supabase
TELEGRAM_BOT_TOKEN="chave"
TELEGRAM_BOT_USERNAME="username_do_bot"
OPENAI_API_KEY="chave"
OPENAI_MODEL="Model"

# WhatsApp (Evolution GO)
EVOLUTION_BASE_URL=https://evolution.chebl.cloud
# Token da instância (UUID) — visível no painel Evolution → Instances.
# NÃO use o GLOBAL_API_KEY do servidor Evolution aqui.
EVOLUTION_API_KEY=00000000-0000-0000-0000-000000000000
EVOLUTION_WEBHOOK_PATH=/api/evolution/webhook
EVOLUTION_SUBSCRIBE_EVENTS=ALL
EVOLUTION_AUTO_CONNECT=true
PUBLIC_BASE_URL=https://seu-dominio
WHATSAPP_NUMBER="5511999999999"

# Garage (S3-compatible) — backend only, never expose credentials to the frontend
S3_ENDPOINT=https://s3-....coolify.chebl.cloud
S3_REGION=garage
S3_BUCKET=jardim-das-conquistas
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGNED_EXPIRES=3600

# Chave opcional para scripts/check-s3-cors.sh
S3_CORS_TEST_KEY=assets/pontual/stars/a/1.png
production=true
